APP_ENV=development
DATABASE_URL=postgresql://flux:flux@localhost:5432/fluxinvoice
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Development uses Mailpit; verification and password resets require SMTP.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@example.test
# Pinned KoSIT assets: npm run compliance:install
# Set an absolute Java 21 executable path (or install the local java-bin link).
# JAVA_BIN=/absolute/path/to/java
# COMPLIANCE_HOME=/absolute/path/to/FluxInvoice/.local/compliance
# Development only; production/staging require S3_OBJECT_LOCK.
ARCHIVE_MODE=LOCAL
# ARCHIVE_LOCAL_DIR=/absolute/path/to/FluxInvoice/.local/archive
# ARCHIVE_MODE=S3_OBJECT_LOCK
# AWS_REGION=eu-central-1
# ARCHIVE_BUCKET=your-private-retained-invoices
# ARCHIVE_KMS_KEY_ARN=arn:aws:kms:eu-central-1:ACCOUNT:key/KEY
# Use workload identity / IAM roles, not committed AWS access keys.
# Invoice delivery: platform-controlled, provider-verified envelope address.
DELIVERY_FROM=invoices@example.test
# Optional HTTPS gateway adapter instead of SMTP (see docs/INVOICE-DELIVERY.md).
# DELIVERY_GATEWAY_URL=https://mail-gateway.example.test/send
# DELIVERY_GATEWAY_TOKEN=secret-from-your-secret-manager
# DELIVERY_WEBHOOK_SECRET=at-least-32-random-secret-characters

# ERechno public origin; set the canonical HTTPS origin before production indexing.
# APP_URL=https://your-production-domain.example
# COMPANY_NAME=Your actual legal company name
# SUPPORT_EMAIL=support@your-production-domain.example
# GOOGLE_SITE_VERIFICATION=Search Console verification token
# LEGAL_NOTICE=Complete, reviewed legal notice (plain text)
# PRIVACY_NOTICE=Complete, reviewed privacy notice (plain text)

# Hosted SaaS subscription checkout (server-only; configure locally, never in chat).
BILLING_ENABLED=false
# STRIPE_SECRET_KEY=<provider-issued-secret>
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_BUSINESS=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_PORTAL_CONFIGURATION=bpc_... # cancellation at the end of the paid period
# STRIPE_PAYPAL_ENABLED=true # enable only after recurring PayPal approval
# STRIPE_AUTOMATIC_TAX=true # requires configured Stripe Tax and correct price tax behavior
# BILLING_DATABASE_URL=postgresql://billing-role:secret@host/database

# Hosted web (Production AND Preview): APP_ENV=production / staging respectively.
# Replace ALL development settings above; never upload this file to Vercel.
# APP_URL and BETTER_AUTH_URL must be the same public HTTPS origin.
# First deployment: use the assigned stable Vercel project URL for both.
# Once DNS/TLS is connected manually: https://erechno.de for both.
# DATABASE_URL=<provider-issued pooled PostgreSQL URL with sslmode=verify-full>
# SMTP_URL=<provider-issued authenticated smtps URL>
# MAIL_FROM=<verified provider sender address>
# ARCHIVE_MODE=S3_OBJECT_LOCK
# ARCHIVE_BUCKET=<private versioned Object Lock bucket name>
# ARCHIVE_KMS_KEY_ARN=<dedicated KMS key ARN>
# AWS_REGION=<bucket region>
# AWS_ACCESS_KEY_ID=<restricted IAM credential; required on Vercel; worker may use IAM workload role>
# AWS_SECRET_ACCESS_KEY=<secret-manager value; required on Vercel; worker may use IAM workload role>
# AWS_SESSION_TOKEN=<temporary credential token, if applicable>
# Worker additionally requires DELIVERY_FROM and absolute JAVA_BIN/COMPLIANCE_HOME.
# See docs/PRODUCTION-ENVIRONMENT.md for the authoritative inventory.
