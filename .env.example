APP_ENV=development
DATABASE_URL=postgresql://flux:flux@localhost:5432/fluxinvoice
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Development uses Mailpit; verification and password resets require SMTP.
SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@example.test
# Pinned KoSIT assets: npm run compliance:install
# Set an absolute Java 21 executable path (or install the local java-bin link).
# JAVA_BIN=/absolute/path/to/java
# COMPLIANCE_HOME=/absolute/path/to/FluxInvoice/.local/compliance
# Development only; production/staging require S3_OBJECT_LOCK.
ARCHIVE_MODE=LOCAL
# ARCHIVE_LOCAL_DIR=/absolute/path/to/FluxInvoice/.local/archive
# ARCHIVE_MODE=S3_OBJECT_LOCK
# AWS_REGION=eu-central-1
# ARCHIVE_BUCKET=your-private-retained-invoices
# ARCHIVE_KMS_KEY_ARN=arn:aws:kms:eu-central-1:ACCOUNT:key/KEY
# Use workload identity / IAM roles, not committed AWS access keys.
