{
  "name": "fluxinvoice",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "npm run build -w @flux/web",
    "start": "npm run start -w @flux/web",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "tsx scripts/e2e.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:local": "tsx scripts/local-db.ts",
    "worker": "tsx scripts/worker.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "compliance:install": "tsx scripts/install-compliance.ts",
    "compliance:check": "vitest run tests/einvoice.test.ts",
    "archive:reconcile": "tsx scripts/reconcile.ts",
    "reader:prepare": "node --import tsx scripts/prepare-reader.ts",
    "prebuild": "npm run reader:prepare",
    "predev": "npm run reader:prepare",
    "dev:account": "tsx scripts/local-account.ts",
    "autopilot:reconcile": "tsx scripts/autopilot-reconcile.ts",
    "production:check": "tsx scripts/production-check.ts",
    "production:databases": "node --import tsx scripts/provision-databases.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@fontsource-variable/inter": "5.3.0",
    "@opentelemetry/api": "1.9.1",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@tesseract.js-data/deu": "1.0.0",
    "@xmldom/xmldom": "0.9.12",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.3",
    "jsqr": "1.4.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "nodemailer": "10.0.15",
    "pdfjs-dist": "6.4.299",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "stripe": "23.0.0",
    "tailwind-merge": "3.7.0",
    "tesseract.js": "7.0.0",
    "xmlbuilder2": "4.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "fast-check": "4.10.2",
    "node": "24.21.0",
    "prettier": "3.9.9",
    "qrcode": "1.5.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "type": "module",
  "overrides": {
    "esbuild": "0.28.2"
  },
  "description": "ERechno \u2013 E-Rechnungen einfach gemacht."
}
